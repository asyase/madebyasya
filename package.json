{
  "name": "asya-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-output.mjs",
    "build": "BUILD_PIPELINE=1 next build && node scripts/prune-unpublished.mjs && node scripts/verify-unpublished.mjs",
    "build:preview": "node scripts/clean-output.mjs && BUILD_PIPELINE=1 SHOW_UNPUBLISHED=1 next build && node scripts/verify-unpublished.mjs --preview",
    "start": "npx serve out",
    "lint": "next lint"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/geist-mono": "5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "5.2.5",
    "@fontsource/instrument-serif": "5.2.5",
    "clsx": "2.1.1",
    "framer-motion": "12.23.0",
    "lucide-react": "0.525.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "overrides": {
    "motion-dom": "12.22.0",
    "motion-utils": "12.19.0"
  }
}
